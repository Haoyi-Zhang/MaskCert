(define-fun mass () Int (+ (ite (and (and (or (and (<= 0 y) (< y 1)) (and (<= 2 y) (< y 7))) (not (or (and (<= 0 y) (< y 2)) (and (<= 5 y) (< y 6))))) (not (and (<= 2 i) (< i 7) (= (mod i 5) 0) (or (and (<= 2 y) (< y 5)) (and (<= 6 y) (< y 7)))))) 1 0) (ite (and (<= 2 i) (< i 7) (= (mod i 5) 0) (and (<= 2 y) (< y 3))) 1 0) (ite (and (<= 2 i) (< i 7) (= (mod i 5) 0) (or (and (<= 3 y) (< y 5)) (and (<= 6 y) (< y 7)))) 1 0)))
(assert (not (= mass (ite wanted 1 0))))
(check-sat)
