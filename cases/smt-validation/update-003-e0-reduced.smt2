(set-logic QF_LIA)
(set-option :timeout 10000)
(set-option :smt.threads 1)
(set-option :produce-models true)
(declare-const i Int)
(define-fun y () Int (mod (+ (* 1 i) 1) 8))
(assert (and (<= 0 i) (< i 8)))
(define-fun wanted () Bool (and (or (and (<= 1 y) (< y 4)) (and (<= 5 y) (< y 8))) (not false)))
(define-fun mass () Int (ite (and (and (or (and (<= 1 y) (< y 4)) (and (<= 5 y) (< y 8))) (not false)) (not (or (and (<= 2 i) (< i 8) (= (mod i 1) 0) (or (and (<= 1 y) (< y 4)) (and (<= 5 y) (< y 8)))) (and (<= 0 i) (< i 0) (= (mod i 1) 0) false) (and (<= 0 i) (< i 0) (= (mod i 1) 0) false)))) 1 0))
(assert (not (= mass (ite wanted 1 0))))
(check-sat)
