(set-logic QF_LIA)
(set-option :timeout 10000)
(set-option :smt.threads 1)
(set-option :produce-models true)
(declare-const i Int)
(define-fun y () Int (mod (+ (* 2 i) 2) 7))
(assert (and (<= 0 i) (< i 7)))
(define-fun wanted () Bool (and (or (and (<= 1 y) (< y 2)) (and (<= 3 y) (< y 5)) (and (<= 6 y) (< y 7))) (not (and (<= 0 y) (< y 1)))))
(define-fun mass () Int (ite (and (and (or (and (<= 1 y) (< y 2)) (and (<= 3 y) (< y 5)) (and (<= 6 y) (< y 7))) (not (and (<= 0 y) (< y 1)))) (not false)) 1 0))
(assert (not (= mass (ite wanted 1 0))))
(check-sat)
