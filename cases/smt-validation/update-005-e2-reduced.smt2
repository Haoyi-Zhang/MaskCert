(set-logic QF_LIA)
(set-option :timeout 10000)
(set-option :smt.threads 1)
(set-option :produce-models true)
(declare-const i Int)
(define-fun y () Int (mod (+ (* 14 i) 3) 17))
(assert (and (<= 0 i) (< i 17)))
(define-fun wanted () Bool (and (or (and (<= 1 y) (< y 4)) (and (<= 6 y) (< y 7)) (and (<= 8 y) (< y 11)) (and (<= 12 y) (< y 17))) (not (or (and (<= 10 y) (< y 11)) (and (<= 12 y) (< y 13))))))
(define-fun mass () Int (ite (and (and (or (and (<= 1 y) (< y 4)) (and (<= 6 y) (< y 7)) (and (<= 8 y) (< y 11)) (and (<= 12 y) (< y 17))) (not (or (and (<= 10 y) (< y 11)) (and (<= 12 y) (< y 13))))) (not false)) 1 0))
(assert (not (= mass (ite wanted 1 0))))
(check-sat)
