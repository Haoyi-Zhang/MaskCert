(set-logic QF_LIA)
(set-option :timeout 10000)
(set-option :smt.threads 1)
(set-option :produce-models true)
(declare-const i Int)
(define-fun y () Int (mod (+ (* 0 i) 0) 1))
(assert (and (<= 0 i) (< i 1)))
(define-fun wanted () Bool (and false (not false)))
(define-fun mass () Int (+ (ite (and (<= 0 i) (< i 0) (= (mod i 2) 0) false) 1 0) (ite (and (<= 0 i) (< i 0) (= (mod i 2) 1) false) 1 0) (ite (and (<= 0 i) (< i 1) (= (mod i 3) 0) false) 1 0) (ite (and (<= 0 i) (< i 0) (= (mod i 1) 0) false) 1 0) (ite (and (<= 0 i) (< i 0) (= (mod i 1) 0) false) 1 0) (ite (and (<= 0 i) (< i 1) (= (mod i 3) 2) false) 1 0) (ite (and (<= 0 i) (< i 1) (= (mod i 3) 1) false) 1 0)))
(assert (not (= mass (ite wanted 1 0))))
(check-sat)
