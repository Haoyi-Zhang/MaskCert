(set-logic QF_LIA)
(set-option :timeout 10000)
(set-option :smt.threads 1)
(set-option :produce-models true)
(declare-const i Int)
(define-fun y () Int (mod (+ (* 14 i) 4) 15))
(assert (and (<= 0 i) (< i 15)))
(define-fun wanted () Bool (and (or (and (<= 0 y) (< y 5)) (and (<= 6 y) (< y 9)) (and (<= 10 y) (< y 15))) (not (or (and (<= 4 y) (< y 5)) (and (<= 12 y) (< y 15))))))
(define-fun mass () Int (+ (ite (and (and (or (and (<= 0 y) (< y 5)) (and (<= 6 y) (< y 9)) (and (<= 10 y) (< y 15))) (not (or (and (<= 4 y) (< y 5)) (and (<= 12 y) (< y 15))))) (not false)) 1 0) (ite (and (<= 0 i) (< i 0) (= (mod i 1) 0) false) 1 0)))
(assert (not (= mass (ite wanted 1 0))))
(check-sat)
