(assert (and (<= 0 i) (< i 17)))
(define-fun wanted () Bool (and (or (and (<= 0 y) (< y 1)) (and (<= 2 y) (< y 5)) (and (<= 6 y) (< y 17))) (not (or (and (<= 0 y) (< y 2)) (and (<= 6 y) (< y 7)) (and (<= 8 y) (< y 11)) (and (<= 14 y) (< y 15)) (and (<= 16 y) (< y 17))))))
(define-fun mass () Int (ite (and (and (or (and (<= 0 y) (< y 1)) (and (<= 2 y) (< y 5)) (and (<= 6 y) (< y 17))) (not (or (and (<= 0 y) (< y 2)) (and (<= 6 y) (< y 7)) (and (<= 8 y) (< y 11)) (and (<= 14 y) (< y 15)) (and (<= 16 y) (< y 17))))) (not false)) 1 0))
(assert (not (= mass (ite wanted 1 0))))
(check-sat)
