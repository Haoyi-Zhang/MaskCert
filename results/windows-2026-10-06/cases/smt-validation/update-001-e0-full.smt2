(set-logic QF_LIA)
(set-option :timeout 10000)
(set-option :smt.threads 1)
(set-option :produce-models true)
(declare-const i Int)
(define-fun y () Int (mod (+ (* 1 i) 0) 2))
(assert (and (<= 0 i) (< i 2)))
(define-fun wanted () Bool (and (and (<= 0 y) (< y 2)) (not false)))
(define-fun mass () Int (+ (ite (and (<= 0 i) (< i 0) (= (mod i 1) 0) (and (<= 0 y) (< y 2))) 1 0) (ite (and (<= 0 i) (< i 2) (= (mod i 4) 0) (and (<= 0 y) (< y 2))) 1 0) (ite (and (<= 0 i) (< i 2) (= (mod i 4) 1) (and (<= 0 y) (< y 2))) 1 0) (ite (and (<= 0 i) (< i 2) (= (mod i 4) 2) (and (<= 0 y) (< y 2))) 1 0) (ite (and (<= 0 i) (< i 2) (= (mod i 4) 3) (and (<= 0 y) (< y 2))) 1 0) (ite (and (<= 0 i) (< i 0) (= (mod i 1) 0) false) 1 0) (ite (and (<= 0 i) (< i 0) (= (mod i 1) 0) false) 1 0)))
(assert (not (= mass (ite wanted 1 0))))
(check-sat)
